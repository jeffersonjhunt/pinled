menu "pinled configuration"

    menu "GPIO assignment (QT Py ESP32-S3 defaults)"
        config PINLED_CLK_GPIO
            int "74x161 CLK GPIO (shared bus)"
            default 18
            help
                A0 on the QT Py ESP32-S3.
        config PINLED_MR_GPIO
            int "74x161 /MR reset GPIO (shared bus, active low)"
            default 17
            help
                A1 on the QT Py ESP32-S3.
        config PINLED_DATA_GPIO
            int "DATA_IN GPIO (shared by every module on the chain)"
            default 9
            help
                A2 on the QT Py ESP32-S3. All modules bus their tri-state '251
                outputs onto this one line; only the addressed module drives it.
                This is not per-module — chaining costs no additional GPIO.
        config PINLED_LED_GPIO
            int "WS2812B/SK6812 data GPIO (RMT)"
            default 8
            help
                A3 on the QT Py ESP32-S3.

        # Note: the POC defaults (25/27/26/15) are unusable here. GPIO 26 and 27
        # are SPI flash pins on the ESP32-S3, and 15 and 25 are not broken out
        # on this board.
    endmenu

    menu "Scan geometry"
        config PINLED_NUM_MODULES
            int "Number of 16-channel modules on the bus"
            range 1 8
            default 1
        config PINLED_CHANNELS_PER_MODULE
            int "Channels per module (8 = single mux, 16 = dual '251)"
            range 8 16
            default 16
        config PINLED_ACTIVE_LOW
            bool "Front end is active-low (inverting)"
            default n
            help
                The v2 front end is a level-shift MOSFET (inverting) followed by
                an inverting Schmitt trigger, so it is non-inverting overall:
                lamp on reads as logic high. Leave this off for v2 hardware.

                This must stay consistent with the orientation of the DATA_IN
                bias resistor: a floating or unpopulated bus has to read "lamp
                off", which for a non-inverting front end means a pull-down.
                See docs/TIMING.md section 4.2.
    endmenu

    menu "Timing"
        config PINLED_SAMPLE_RATE_HZ
            int "Per-channel raw sample rate (Hz)"
            default 2000
        config PINLED_REFRESH_HZ
            int "LED frame rate (Hz)"
            range 30 240
            default 90
    endmenu

    menu "Filament model defaults"
        config PINLED_ATTACK_MS
            int "Filament attack time constant (ms)"
            default 30
        config PINLED_DECAY_MS
            int "Filament decay time constant (ms)"
            default 40
    endmenu

    menu "LED string"
        config PINLED_LED_COUNT
            int "Number of addressable LEDs"
            default 16
    endmenu

endmenu
